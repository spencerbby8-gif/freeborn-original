{
  "name": "freeborn",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:harness": "esbuild scripts/trust/harness.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.harness.build.mjs --packages=external && node scripts/trust/.harness.build.mjs",
    "test:deletion-local": "node scripts/trust/fb14-deletion-local.mjs",
    "test:retention-local": "node scripts/trust/fb15-retention-local.mjs",
    "test:retention-worker": "npx --yes deno@2 test --allow-env supabase/functions/fb15-selfie-retention/worker.test.ts",
    "test:pose": "node scripts/trust/pose-run.mjs",
    "test:pose:negctl": "bash scripts/trust/pose-negctl.sh",
    "test:security": "npm run test:harness && npm run test:engines && npm run test:pose",
    "test:engines": "esbuild scripts/trust/engine-request.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.engine-request.build.mjs --packages=external && node scripts/trust/.engine-request.build.mjs",
    "test:db-tls": "esbuild scripts/trust/db-tls.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.db-tls.build.mjs --packages=external && node scripts/trust/.db-tls.build.mjs",
    "test:turn": "esbuild scripts/trust/turn-cloudflare.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.turn-cloudflare.build.mjs --packages=external && node scripts/trust/.turn-cloudflare.build.mjs",
    "check:env": "node scripts/check-env-isolation.mjs",
    "check:migrations": "node scripts/db/check-migrations.mjs",
    "db:clean-replay": "node scripts/db/clean-replay.mjs",
    "test:preview-auth": "esbuild scripts/trust/preview-auth-acceptance.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.preview-auth-acceptance.build.mjs --packages=external && node scripts/trust/.preview-auth-acceptance.build.mjs",
    "test:preview-deletion-verify": "esbuild scripts/trust/preview-auth-deletion-verify.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.preview-auth-deletion-verify.build.mjs --packages=external && node scripts/trust/.preview-auth-deletion-verify.build.mjs",
    "test:prepare-local": "node scripts/trust/prepare-local-db.mjs",
    "test:preview-deletion-drain": "esbuild scripts/trust/preview-deletion-drain.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/trust/.preview-deletion-drain.build.mjs --packages=external && node scripts/trust/.preview-deletion-drain.build.mjs",
    "test:profile-trigger": "node scripts/trust/profile-write-trigger-local.mjs",
    "test:prototype-api": "node scripts/prototype/api-contracts.mjs",
    "test:prototype-ui": "node scripts/prototype/ui-acceptance.cjs",
    "test:chat-verification": "node scripts/prototype/chat-verification.cjs",
    "test:setup-interactions": "node scripts/prototype/setup-interactions.cjs",
    "test:chat-media": "node scripts/prototype/chat-media-contracts.mjs",
    "test:discovery-privacy": "node scripts/prototype/discovery-privacy-contracts.mjs",
    "test:experience-db": "node scripts/prototype/discovery-local-db.mjs",
    "test:landing": "node scripts/prototype/landing-acceptance.cjs",
    "test:filter-storage": "node scripts/prototype/filter-storage-contracts.mjs",
    "test:landing-a11y": "node scripts/prototype/landing-a11y.cjs",
    "test:discovery-presentation": "node scripts/prototype/discovery-presentation-contracts.mjs",
    "test:notification-receipts": "node scripts/prototype/notification-receipts-contracts.mjs",
    "test:bing-metadata": "node scripts/seo/bing-metadata-contracts.mjs && python3 -m unittest discover -s scripts/seo -p test_bing_metadata.py",
    "check:crawl-health": "node scripts/seo/crawl-health.mjs",
    "test:discovery-settings": "node scripts/prototype/discovery-settings.cjs",
    "test:member-runtime": "node scripts/prototype/member-runtime-regressions.mjs",
    "test:member-auth": "node scripts/prototype/member-auth-regressions.mjs",
    "test:auth-onboarding": "node scripts/prototype/auth-onboarding.cjs",
    "test:evidence-safety": "node scripts/seo/public-evidence-contracts.mjs",
    "test:member-experience": "node scripts/member-experience/integration.mjs",
    "test:member-experience-ui": "node scripts/member-experience/browser.mjs",
    "test:member-migration": "node scripts/member-experience/migration.mjs",
    "test:settings-audit": "node scripts/settings-audit/integration.mjs",
    "test:settings-ui": "node scripts/settings-audit/browser.mjs",
    "test:notification-migration": "node scripts/settings-audit/migration.mjs",
    "test:settings-prepare": "node scripts/settings-audit/prepare.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "svix": "^2.11.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.14.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7",
    "esbuild": "0.28.2",
    "minimatch": "^11.0.1",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
