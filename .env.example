# Freeborn — environment variables template
#
# HOW TO USE THIS FILE
#   1. Copy it to `.env.local` (already gitignored — real values never enter git):
#        cp .env.example .env.local
#   2. Replace every placeholder with your real value.
#   3. For deploys, set the SAME variables in Vercel → Project → Settings →
#      Environment Variables. Production deploys come from pushes to `main`;
#      every branch gets an automatic preview deployment.
#
# PUBLIC vs SECRET
#   NEXT_PUBLIC_* variables are inlined into the browser bundle — they are
#   public by design (Supabase publishable keys are protected by RLS,
#   Turnstile site keys are meant to be visible). Never put a service-role
#   key, pooler password, or TURN credential in a NEXT_PUBLIC_* variable.
#
# Scope sample (Vercel, production): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_TRANSACTION_POOLER, NEXT_PUBLIC_APP_URL are set for
# production+preview+development. Engine keys are sensitive, production only.

## ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key. Public by design; RLS is the guard.
NEXT_PUBLIC_SUPABASE_URL=https://ihwtpwlszegrjgakqsxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Server-side aliases — the code falls back to the NEXT_PUBLIC_ values above.
SUPABASE_URL=https://ihwtpwlszegrjgakqsxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

## ── Database (SECRET) ───────────────────────────────────────────────────────
# Supabase transaction pooler connection string. The app prefers this var.
# Format: postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_TRANSACTION_POOLER=postgresql://postgres:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Fallback if the pooler var is unset (local dev only):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional pool sizing:
# PGPOOL_MAX=10

## ── Verification & moderation engines (SECRET — server-side only) ───────────
# Engine 1 (required for verification + moderation stage 1):
ANTIGRAVITY_BASE_URL=https://your-engine1-gateway.example.com
ANTIGRAVITY_FREE_API_KEY=your_engine1_key_here
# Engine 2 (optional — report triage + verification stage 2 degrade to
# single-engine without it):
VOID_AI_BASE_URL=https://your-engine2-gateway.example.com
VOID_AI_API_KEY=your_engine2_key_here
# Engine 3 / LM7 lane (optional local/self-hosted lane used by src/lib/lm7.ts):
# LM7_BASE_URL=https://your-lm7.example.com
# LM7_API_KEY=your_lm7_key_here

## ── Operator tools (SECRET-ish — server-side only) ──────────────────────────
# Comma-separated emails allowed to read /api/health/engines (audit F1, 2026-10-27).
# If unset the route stays 404 for everyone.
FREEBORN_ADMIN_EMAILS=you@example.com

## ── Abuse brakes ────────────────────────────────────────────────────────────
# Cloudflare Turnstile (site key is public by design; secret stays server-side).
# When unset, challenge screens degrade cleanly — but signup stays unwalled,
# so set both before opening the doors to growth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4your_site_key_here
# TURNSTILE_SECRET_KEY=0x4your_secret_key_here   (planned trust layer, Phase 3)

## ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://freeborn-umber.vercel.app

## ── Same-site enforcement (optional) ────────────────────────────────────────
# Comma-separated extra origins allowed to call the API cross-origin, beyond
# NEXT_PUBLIC_APP_URL (see src/lib/request-guard.ts):
# FREEBORN_ALLOWED_ORIGINS=https://your-preview.example.com
# FREEBORN_ALLOW_CROSS_SITE_COOKIES=false   (true only for embedded contexts)

## ── TURN server for calls (SECRET — server-side only, never NEXT_PUBLIC_) ───
# Calls work without these (host/srflx candidates only), but restrictive NATs
# need a relay. Provision metered.ca / Cloudflare Calls, then set:
# FREEBORN_TURN_URL=turn:your-turn-server.example.com:3478
# FREEBORN_TURN_USER=your_turn_username
# FREEBORN_TURN_CRED=your_turn_credential
