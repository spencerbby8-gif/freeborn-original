# Freeborn — environment variables template
#
# HOW TO USE THIS FILE
#   1. Copy it to `.env.local` (already gitignored — real values never enter git):
#        cp .env.example .env.local
#   2. Replace every placeholder with your real value.
#   3. For Netlify deploys, set the SAME variables in:
#        Site settings → Project configuration → Environment variables
#      (Netlify injects them at build time; the token you use for the Netlify
#      CLI is unrelated to these app secrets.)
#
# PUBLIC vs SECRET
#   NEXT_PUBLIC_* variables are inlined into the browser bundle — they are
#   public by design (Supabase publishable keys are protected by RLS,
#   Turnstile site keys are meant to be visible). Never put a service-role
#   key, pooler password, or TURN credential in a NEXT_PUBLIC_* variable.

## ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key. Public by design; RLS is the guard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Server-side aliases — the code falls back to the NEXT_PUBLIC_ values above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

## ── Database (SECRET) ───────────────────────────────────────────────────────
# Supabase transaction pooler connection string. The app prefers this var.
# Format: postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_TRANSACTION_POOLER=postgresql://postgres:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Fallback if the pooler var is unset (local dev only):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

## ── Verification engines (SECRET — server-side only) ────────────────────────
# Stage 1 (required for verification):
ANTIGRAVITY_BASE_URL=https://your-stage1-engine.example.com
ANTIGRAVITY_FREE_API_KEY=your_stage1_key_here
# Stage 2 (optional — app falls back to single-engine verification without it):
VOID_AI_BASE_URL=https://your-stage2-engine.example.com
VOID_AI_API_KEY=your_stage2_key_here

## ── Cloudflare Turnstile (site key is public by design) ─────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4your_site_key_here

## ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://freeborn.netlify.app

## ── TURN server for calls (SECRET — server-side only, never NEXT_PUBLIC_) ───
FREEBORN_TURN_URL=turn:your-turn-server.example.com:3478
FREEBORN_TURN_USER=your_turn_username
FREEBORN_TURN_CRED=your_turn_credential
